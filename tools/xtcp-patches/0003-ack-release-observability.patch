diff '--unified=0' -rN a/src/core/stack.cpp b/src/core/stack.cpp
--- a/src/core/stack.cpp	2026-09-01 09:44:44.012972223 +0800
+++ b/src/core/stack.cpp	2026-09-01 09:44:44.104971875 +0800
@@ -1419,0 +1420,26 @@
+    core::AckReleaseTelemetrySnapshot XtcpStack::AckReleaseTelemetry() const noexcept {
+        core::AckReleaseTelemetrySnapshot total;
+        const auto add = [&total](const core::AckReleaseTelemetrySnapshot& value) noexcept {
+            total.valid_acks += value.valid_acks;
+            total.ack_advance_events += value.ack_advance_events;
+            total.ack_advance_bytes += value.ack_advance_bytes;
+            total.pending_flush_attempts += value.pending_flush_attempts;
+            total.tx_sink_packets += value.tx_sink_packets;
+            total.tx_sink_bytes += value.tx_sink_bytes;
+            total.pending_flush_pacing += value.pending_flush_pacing;
+            total.pending_flush_window_cwnd += value.pending_flush_window_cwnd;
+            total.pending_flush_fast_recovery_pipe += value.pending_flush_fast_recovery_pipe;
+            total.pending_flush_packet_allocation += value.pending_flush_packet_allocation;
+        };
+        for (UInt32 i = 0; i < kShardCount; ++i) {
+            Shard& shard = shards_[i];
+            std::lock_guard<std::recursive_mutex> scope(shard.syncobj_);
+            for (const auto& entry : shard.conns_) {
+                if (NULLPTR != entry.second && NULLPTR != entry.second->conn) {
+                    add(entry.second->conn->AckReleaseTelemetry());
+                }
+            }
+        }
+        return total;
+    }
+
