+              static_cast<UInt16>(xtcp::core::kFlagAck | (ece ? xtcp::core::kFlagEce : 0)));
+    ssth_after = h.conn.Ssthresh();
+    return h.conn.Cwnd();
+}
+
+static void TestEcnCutSurvivesSameAck() {
+    xtcp::cc::RegisterKcc();
+    UInt32 before_ece = 0, before_plain = 0, ssth_ece = 0, ssth_plain = 0;
+    const UInt32 after_ece = KccEceTwin(true, before_ece, ssth_ece);
+    const UInt32 after_plain = KccEceTwin(false, before_plain, ssth_plain);
