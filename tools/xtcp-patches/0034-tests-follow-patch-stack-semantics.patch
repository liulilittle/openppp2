+    namespace cc {
+        // plugins/cc_kcc_probe.h (test-only seed hook, linked via RegisterKcc).
+        void KccTestSetRandomSeed(UInt32 seed) noexcept;
+    }
+}
+
+static UInt32 KccEceTwin(bool ece, UInt32& cwnd_before, UInt32& ssth_after) {
