+    UInt64 XtcpStack::NextTimerDeadlineUs() noexcept {
+        UInt64 next = kNoTimerDeadline;
+        const core::TimePoint pacing = qdisc_next_pacing_.load(std::memory_order_relaxed);
+        if (0 != pacing && pacing < next) {
+            next = pacing;
+        }
+        for (UInt32 i = 0; i < kShardCount; ++i) {
+            Shard& shard = shards_[i];
+            // A pending TX backpressure retry must drain on the next sweep:
+            // report "due now" without walking the connection table.
+            if (NULLPTR != shard.tx_retry_head_.load(std::memory_order_relaxed)) {
+                return 0;
+            }
+            // Mirror of the PollAckTimers fast path: a shard whose sweep hint
+            // is clear has no connection with armed timers - skip the lock.
+            if (!shard.sweep_hint_.load(std::memory_order_relaxed)) {
+                continue;
+            }
+            std::lock_guard<std::recursive_mutex> scope(shard.syncobj_);
+            for (const auto& entry : shard.conns_) {
+                const ConnEntry* e = entry.second;
+                if (NULLPTR == e || NULLPTR == e->conn) {
+                    continue;
+                }
+                const core::TimePoint due = e->conn->NextTimerDeadline();
+                if (due < next) {
+                    next = due;
+                    if (0 == next) {
+                        return 0;
+                    }
+                }
+            }
+        }
+        return next;
+    }
