+static void TestKccRoundBoundaryTracksFlight() {
+    xtcp::cc::RegisterKcc();
+    const xtcp::cc::XtcpCongestionOps* ops = xtcp::cc::FindCongestionControl("kcc");
+    CHECK(NULLPTR != ops);
+
+    kcc_core ref;
+    kcc_core_init(&ref);
+    ref.mss = 1460;
+    ref.last_ack_us = 1000000;
+
+    xtcp::cc::XtcpConnCc sk;
+    ops->init(&sk);
+    sk.mss = 1460;
+    constexpr UInt32 kDelivered = 1460;
+    constexpr UInt32 kFlight = 20 * 1460;
+    constexpr UInt32 kInterval = 1000;
+    UInt64 now_us = 1000000;
+
+    // Twenty one small ACK samples carry one flight. The round counter must
+    // not treat each sample as a separate RTT; it advances again only after
+    // the delivery marker reaches the next flight boundary.
+    for (UInt32 i = 0; i < 21; ++i) {
+        now_us += kInterval;
+        kcc_core_on_ack(&ref, static_cast<s64>(now_us), kDelivered, 1000,
+                        kFlight, 0);
+        sk.inflight = kFlight;
+        xtcp::cc::RateSample rs;
+        rs.delivered = kDelivered;
+        rs.interval_us = kInterval;
+        rs.rtt_us = 1000;
+        rs.acked = kDelivered;
+        ops->cong_control(&sk, &rs);
+        CHECK(1 == ref.rtt_cnt);
+        CHECK(static_cast<UInt32>(kcc_core_cwnd_segs(&ref)) == sk.snd_cwnd);
+    }
+
+    now_us += kInterval;
+    kcc_core_on_ack(&ref, static_cast<s64>(now_us), kDelivered, 1000,
+                    kFlight, 0);
+    xtcp::cc::RateSample rs;
+    rs.delivered = kDelivered;
+    rs.interval_us = kInterval;
+    rs.rtt_us = 1000;
+    rs.acked = kDelivered;
+    ops->cong_control(&sk, &rs);
+    CHECK(2 == ref.rtt_cnt);
+    CHECK(static_cast<UInt32>(kcc_core_cwnd_segs(&ref)) == sk.snd_cwnd);
+    ops->release(&sk);
+}
